:global proxyForwardTo
:global proxyAddressList
:global proxyComment
:if ([:typeof $proxyForwardTo] = "nothing") do={ :error "proxyForwardTo is required" }
:if ([:typeof $proxyAddressList] = "nothing") do={ :error "proxyAddressList is required" }
:if ([:typeof $proxyComment] = "nothing") do={ :global proxyComment "PROXY" }
/ip/dns/static/remove [find where comment=$proxyComment]
/ip/dns/static
